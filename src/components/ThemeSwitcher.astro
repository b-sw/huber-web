---
// Review tool for trying colour themes (light only). It lives in VariantNav and goes away with it.
// A theme is a grey ramp from one hue, tint and background lightness, plus one accent. Pages read the
// result as --t-* tokens and fall back to their own colours when no theme is set.
---

<script is:inline>
  (() => {
    const KEY = 'huber-theme';
    const PRESETS = [
      { id: 'karton', name: 'Karton', h: 75, c: 0.024, bl: 94.5, ah: 65, ac: 0.085, al: 70 },
      { id: 'biel', name: 'Biel', h: 0, c: 0, bl: 99, ah: 40, ac: 0.19, al: 64 },
      { id: 'len', name: 'Len', h: 92, c: 0.016, bl: 96, ah: 82, ac: 0.1, al: 60 },
      { id: 'szalwia', name: 'Szałwia', h: 150, c: 0.016, bl: 95, ah: 155, ac: 0.09, al: 52 },
      { id: 'mgla', name: 'Mgła', h: 240, c: 0.014, bl: 96, ah: 255, ac: 0.16, al: 54 },
      { id: 'glina', name: 'Glina', h: 55, c: 0.018, bl: 94.5, ah: 35, ac: 0.14, al: 54 },
      { id: 'grafit', name: 'Grafit', h: 265, c: 0.003, bl: 95, ah: 24, ac: 0.19, al: 54 },
    ];
    // Lightness of each job on the grey ramp. Surfaces and lines sit a fixed distance from the background.
    // Text steps keep at least 4.5:1 on the background down to a lightness of 94.
    const steps = (bl) => ({
      bg: bl,
      raised: Math.min(99.6, bl + 1.5),
      surface: bl - 2.8,
      'surface-2': bl - 5,
      line: bl - 8.4,
      'line-2': bl - 13.4,
      plus: bl - 26.4,
      tone: 52,
      soft: 48.5,
      muted: 44,
      'ink-2': 34,
      ink: 19,
    });
    const NAMES = [...Object.keys(steps(0)), 'accent', 'accent-ink', 'on-accent'];

    const linearRgb = (l, c, h) => {
      const a = c * Math.cos((h * Math.PI) / 180);
      const b = c * Math.sin((h * Math.PI) / 180);
      const L = l / 100;
      const lc = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
      const mc = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
      const sc = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
      return [
        4.0767416621 * lc - 3.3077115913 * mc + 0.2309699292 * sc,
        -1.2684380046 * lc + 2.6097574011 * mc - 0.3413193965 * sc,
        -0.0041960863 * lc - 0.7034186147 * mc + 1.707614701 * sc,
      ];
    };

    // Even chroma, so the background carries the tint too. Near white, sRGB holds less chroma, so each
    // step takes the most it can hold up to the theme's value.
    const chromaAt = (l, t) => {
      const fits = (c) => linearRgb(l, c, t.h).every((x) => x >= 0 && x <= 1);
      if (fits(t.c)) return t.c;
      let lo = 0;
      let hi = t.c;
      for (let i = 0; i < 12; i++) {
        const mid = (lo + hi) / 2;
        if (fits(mid)) lo = mid;
        else hi = mid;
      }
      return lo;
    };
    const grey = (l, t) => `oklch(${l}% ${chromaAt(l, t).toFixed(4)} ${t.h})`;

    // Text on the accent: whichever of ink and background reads better on it.
    const onAccent = (t, out) => {
      const lum = (l, c, h) => {
        const [r, g, b] = linearRgb(l, c, h).map((x) => Math.min(1, Math.max(0, x)));
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
      };
      const ratio = (x, y) => (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
      const { ink: inkL, bg: bgL } = steps(t.bl);
      const acc = lum(t.al, t.ac, t.ah);
      const ink = lum(inkL, chromaAt(inkL, t), t.h);
      const bg = lum(bgL, chromaAt(bgL, t), t.h);
      return ratio(acc, ink) >= ratio(acc, bg) ? out.ink : out.bg;
    };

    const tokens = (t) => {
      const out = {};
      for (const [name, l] of Object.entries(steps(t.bl))) out[name] = grey(l, t);
      out.accent = `oklch(${t.al}% ${t.ac} ${t.ah})`;
      out['accent-ink'] = `oklch(${Math.min(t.al, 44)}% ${Math.min(t.ac, 0.14)} ${t.ah})`;
      out['on-accent'] = onAccent(t, out);
      return out;
    };

    const apply = (t) => {
      const root = document.documentElement.style;
      if (!t) {
        NAMES.forEach((n) => root.removeProperty(`--t-${n}`));
        return;
      }
      for (const [n, v] of Object.entries(tokens(t))) root.setProperty(`--t-${n}`, v);
    };

    // A saved preset reloads from PRESETS, so older saves pick up the current preset values.
    const load = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
        const preset = PRESETS.find((p) => p.id === saved?.id);
        return preset ? { ...preset } : saved && { bl: 96, ...saved };
      } catch {
        return null;
      }
    };
    const save = (t) => {
      try {
        if (t) localStorage.setItem(KEY, JSON.stringify(t));
        else localStorage.removeItem(KEY);
      } catch {}
    };

    apply(load());
    window.HuberTheme = { PRESETS, tokens, apply, load, save };
  })();
</script>

<div class="ts" data-ts>
  <button class="ts-toggle" type="button" aria-expanded="false" aria-controls="ts-panel" data-ts-toggle>
    <span class="ts-dots" aria-hidden="true"><span></span><span></span></span>
    Kolory
  </button>
  <div class="ts-panel" id="ts-panel" role="dialog" aria-label="Kolory strony" hidden data-ts-panel>
    <p class="ts-title">Kolory strony <span>narzędzie podglądu</span></p>
    <div class="ts-presets" data-ts-presets>
      <button type="button" class="ts-preset" data-preset="" aria-pressed="true">
        <span class="ts-sw ts-sw--orig" aria-hidden="true"></span>Oryginał
      </button>
    </div>
    <p class="ts-custom" data-ts-custom hidden>Własne kolory (z suwaków)</p>
    <div class="ts-sliders">
      <label><span>Odcień tła <output data-out="h"></output></span><input type="range" min="0" max="360" step="1" data-k="h" /></label>
      <label><span>Nasycenie tła <output data-out="c"></output></span><input type="range" min="0" max="0.04" step="0.001" data-k="c" /></label>
      <label><span>Jasność tła <output data-out="bl"></output></span><input type="range" min="90" max="100" step="0.5" data-k="bl" /></label>
      <label><span>Odcień akcentu <output data-out="ah"></output></span><input type="range" min="0" max="360" step="1" data-k="ah" /></label>
      <label><span>Nasycenie akcentu <output data-out="ac"></output></span><input type="range" min="0" max="0.25" step="0.005" data-k="ac" /></label>
      <label><span>Jasność akcentu <output data-out="al"></output></span><input type="range" min="35" max="80" step="1" data-k="al" /></label>
    </div>
    <div class="ts-actions">
      <button type="button" data-ts-copy>Kopiuj CSS</button>
      <p class="ts-note" aria-live="polite" data-ts-note>Wybór zapisuje się w tej przeglądarce.</p>
    </div>
  </div>
</div>

<script>
  interface Theme {
    id?: string;
    name?: string;
    h: number;
    c: number;
    bl: number;
    ah: number;
    ac: number;
    al: number;
  }
  interface HuberThemeApi {
    PRESETS: Theme[];
    tokens: (t: Theme) => Record<string, string>;
    apply: (t: Theme | null) => void;
    load: () => Theme | null;
    save: (t: Theme | null) => void;
  }

  const api = (window as unknown as { HuberTheme?: HuberThemeApi }).HuberTheme;
  const root = document.querySelector<HTMLElement>('[data-ts]');

  if (api && root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-ts-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-ts-panel]')!;
    const list = root.querySelector<HTMLElement>('[data-ts-presets]')!;
    const note = root.querySelector<HTMLElement>('[data-ts-note]')!;
    const customNote = root.querySelector<HTMLElement>('[data-ts-custom]')!;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-k]')];
    const DEFAULT: Theme = api.PRESETS[0]!;

    for (const p of api.PRESETS) {
      const t = api.tokens(p);
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ts-preset';
      b.dataset.preset = p.id;
      b.setAttribute('aria-pressed', 'false');
      const sw = document.createElement('span');
      sw.className = 'ts-sw';
      sw.setAttribute('aria-hidden', 'true');
      // The button shows the theme background, so the tint reads at a glance. The dot is the accent.
      b.style.background = t.bg;
      sw.style.background = t.accent;
      b.append(sw, p.name!);
      list.append(b);
    }

    // The panel state comes from one value: the saved theme, or null for the page's own colours.
    let current: Theme | null = api.load();

    const render = () => {
      const shown = current ?? DEFAULT;
      list.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
        const id = b.dataset.preset || null;
        b.setAttribute('aria-pressed', String(current ? current.id === id : id === null));
      });
      customNote.hidden = current?.id !== 'custom';
      inputs.forEach((input) => {
        const k = input.dataset.k as keyof Theme;
        input.value = String(shown[k]);
        const out = root.querySelector<HTMLOutputElement>(`[data-out="${k}"]`)!;
        // Every value reads as 0–100 (hues as degrees), so the owner never sees raw OKLCH numbers.
        const value = Number(shown[k]);
        const max = Number(input.max);
        out.textContent =
          k === 'h' || k === 'ah' ? `${value}°` : k === 'al' || k === 'bl' ? `${value}%` : `${Math.round((value / max) * 100)}%`;
      });
    };

    const set = (t: Theme | null) => {
      current = t;
      api.apply(t);
      api.save(t);
      render();
    };

    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-preset]');
      if (!b) return;
      const p = api.PRESETS.find((x) => x.id === b.dataset.preset);
      set(p ? { ...p } : null);
    });
    inputs.forEach((input) =>
      input.addEventListener('input', () => {
        const base = current ?? DEFAULT;
        set({ ...base, id: 'custom', name: 'Własna', [input.dataset.k!]: Number(input.value) });
      }),
    );

    root.querySelector('[data-ts-copy]')!.addEventListener('click', async () => {
      const t = api.tokens(current ?? DEFAULT);
      const css = `:root {\n${Object.entries(t)
        .map(([k, v]) => `  --t-${k}: ${v};`)
        .join('\n')}\n}`;
      try {
        await navigator.clipboard.writeText(css);
        note.textContent = 'Skopiowano tokeny CSS.';
      } catch {
        note.textContent = 'Nie udało się skopiować.';
      }
    });

    const open = (next: boolean) => {
      panel.hidden = !next;
      toggle.setAttribute('aria-expanded', String(next));
    };
    toggle.addEventListener('click', () => open(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        open(false);
        toggle.focus();
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (!panel.hidden && !root.contains(e.target as Node)) open(false);
    });

    render();
  }
</script>

<style>
  .ts {
    font: 13px/1.35 system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: #18181b;
  }

  /* The toggle sits in the dark review bar. */
  .ts-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 10px 0 8px;
    border: 0;
    border-radius: 6px;
    background: #27272a;
    color: #fafafa;
    font-weight: 500;
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 150ms ease;
  }

  .ts-toggle[aria-expanded='true'] {
    background: #3f3f46;
  }

  .ts-toggle:active {
    transform: scale(0.97);
  }

  .ts-dots {
    display: inline-flex;
  }

  .ts-dots span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid #27272a;
    background: var(--t-accent, #c69c6d);
  }

  .ts-dots span:first-child {
    background: var(--t-bg, #f4f4f2);
  }

  .ts-dots span + span {
    margin-left: -5px;
  }

  /* Fixed, so it stays open while the owner scrolls through the sections. */
  .ts-panel {
    position: fixed;
    right: 16px;
    top: 48px;
    z-index: 90;
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    display: grid;
    gap: 14px;
    width: min(320px, calc(100vw - 32px));
    padding: 16px;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.16);
    transform-origin: top right;
    transition:
      opacity 160ms ease,
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1);

    @starting-style {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }

  .ts-panel[hidden] {
    display: none;
  }

  .ts-title {
    font-weight: 600;
  }

  .ts-title span {
    margin-left: 6px;
    font-weight: 400;
    color: #71717a;
  }

  .ts-presets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .ts :global(.ts-preset) {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 4px 8px;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    background: #ffffff;
    text-align: left;
    transition: border-color 150ms ease;
  }

  .ts :global(.ts-preset[aria-pressed='true']) {
    border-color: #18181b;
    box-shadow: inset 0 0 0 1px #18181b;
  }

  .ts :global(.ts-sw) {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
  }

  .ts-sw--orig {
    background: conic-gradient(#ffffff 0 25%, #f9f9f7 0 50%, #c69c6d 0 75%, #111111 0);
    box-shadow: inset 0 0 0 1px #d4d4d8;
  }

  .ts-custom {
    margin-top: -6px;
    font-weight: 600;
  }

  .ts-sliders {
    display: grid;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid #e4e4e7;
  }

  .ts-sliders label {
    display: grid;
    gap: 4px;
  }

  .ts-sliders span {
    display: flex;
    justify-content: space-between;
    color: #52525b;
  }

  .ts-sliders output {
    font-variant-numeric: tabular-nums;
    color: #18181b;
  }

  .ts-sliders input {
    width: 100%;
    accent-color: #18181b;
  }

  .ts-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ts-actions button {
    flex: none;
    height: 32px;
    padding: 0 12px;
    border: 1px solid #d4d4d8;
    border-radius: 8px;
    background: #ffffff;
    font-weight: 600;
  }

  .ts-note {
    color: #71717a;
    font-size: 12px;
  }

  .ts :focus-visible {
    outline: 2px solid #18181b;
    outline-offset: 2px;
  }

  .ts-toggle:focus-visible {
    outline-color: #fafafa;
  }

  @media (hover: hover) and (pointer: fine) {
    .ts :global(.ts-preset:hover),
    .ts-actions button:hover {
      border-color: #a1a1aa;
    }

    .ts-toggle:hover {
      background: #3f3f46;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-panel {
      transition: none;
    }
  }
</style>
