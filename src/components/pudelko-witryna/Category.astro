---
import Shot from './Shot.astro';
import { byMaterial, circuitRange, featureList, materials, type Material } from '../../data/products';
import { configurations, sentence } from './text';

interface Props {
  material: Material;
}

const { material } = Astro.props;
const list = byMaterial(material);
const info = materials[material];
const range = circuitRange(list);
const titleId = `${material}-h`;

const dash = (value: string) => value.replace('-', '–');
const keepLastWord = (value: string) => value.replace(/ (?=\S+$)/, ' ');
const inches = (value: string) => value.replaceAll('½', '1/2').replaceAll('¾', '3/4');
const shortVersion = (v: string) => v.replace(/^Rotametry do /, '').replace(/^Zawór ESBE /, '');
---

<div class="cat" id={material} role="group" aria-labelledby={titleId}>
  <div class="cat-head">
    <h3 class="cat-title rise" id={titleId} data-reveal="rise"><span>{info.label}</span></h3>
    <p class="cat-facts" data-reveal style="--d: 160">
      {configurations(list.length)} · {range.min}–{range.max} obwodów · {keepLastWord(info.bar)}
    </p>
  </div>

  <div class="grid" data-grid>
    {
      list.map((p, i) => {
        const r = circuitRange([p]);
        const twoIndexes = p.variants.length === 2 && p.rows.every((row) => row.indexes.length === 2);
        const panelId = `indeksy-${p.slug}`;
        const buttonId = `produkt-${p.slug}`;
        const specId = `spec-${p.slug}`;
        return (
          <>
            <div class="cell" data-reveal style={`--d: ${(i % 4) * 80}`}>
              <article class="tile" data-tile>
                <Shot
                  slug={p.slug}
                  alt={`Rozdzielacz ${p.code}`}
                  widths={[360, 480, 720, 960]}
                  sizes="(min-width: 1100px) 25vw, (min-width: 900px) 33vw, 50vw"
                  class="tile-shot"
                />
                <div class="tile-text">
                  <h4 class="tile-code">
                    <button
                      class="tile-btn"
                      type="button"
                      id={buttonId}
                      aria-expanded="false"
                      aria-controls={panelId}
                      aria-describedby={specId}
                      data-tile-btn
                    >
                      {p.code}
                      <span class="visually-hidden"> – indeksy i wymiary</span>
                    </button>
                  </h4>
                  <p class="tile-spec" id={specId}>
                    {sentence(featureList(p).join(' · '))}
                  </p>
                  <p class="tile-meta">
                    <span>
                      {r.min}–{r.max} obwodów
                    </span>
                    <span class="tile-more t-link" aria-hidden="true">
                      Indeksy
                      <span class="pm" />
                    </span>
                  </p>
                </div>
              </article>
            </div>

            <div class="panel" id={panelId} role="region" aria-labelledby={buttonId} hidden="until-found" data-panel>
              <div class="panel-in" data-panel-in>
                <span class="panel-tip" aria-hidden="true" />
                <div class="panel-head">
                  <p class="panel-code">{p.code}</p>
                  <p class="panel-title">{p.title}</p>
                  <dl class="panel-dims">
                    <div>
                      <dt>Obwody</dt>
                      <dd>
                        {r.min}–{r.max}
                      </dd>
                    </div>
                    <div>
                      <dt>Wysokość H</dt>
                      <dd>{dash(p.rows[0]!.H)} mm</dd>
                    </div>
                    <div>
                      <dt>Głębokość G</dt>
                      <dd>{p.rows[0]!.G} mm</dd>
                    </div>
                  </dl>
                </div>

                <div class="panel-table">
                  <table>
                    <caption>
                      Indeksy {p.code} · <span class="on-fine">kliknij indeks</span><span class="on-touch"
                        >dotknij indeksu</span
                      >, żeby go skopiować
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Obwody</th>
                        <th scope="col">L, mm</th>
                        {twoIndexes ? (
                          p.variants.map((v) => (
                            <th scope="col" class="idx-h">
                              Indeks <span>{shortVersion(v)}</span>
                            </th>
                          ))
                        ) : (
                          <th scope="col">Indeks</th>
                        )}
                      </tr>
                    </thead>
                    <tbody>
                      {p.rows.map((row) => (
                        <tr>
                          <th scope="row">{row.circuits}</th>
                          <td>{row.L}</td>
                          {(twoIndexes ? row.indexes : row.indexes.slice(0, 1)).map((index) => (
                            <td>
                              <button class="idx" type="button" data-copy={index} aria-label={`Kopiuj indeks ${index}`}>
                                {index}
                              </button>
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <div class="panel-kit">
                  <p class="panel-h">W zestawie</p>
                  <ul class="panel-list" role="list">
                    {p.includes.map((item) => (
                      <li>{inches(item)}</li>
                    ))}
                  </ul>
                </div>

                <button class="panel-close t-link" type="button" data-panel-close>
                  Zamknij
                  <span class="pm is-open" aria-hidden="true" />
                </button>
              </div>
            </div>
          </>
        );
      })
    }
  </div>
</div>

<script>
  // Astro runs this script once per page, so it serves every <Category> and owns the one open panel.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const ease = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-tile-btn]')];
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const panelOf = (btn: HTMLButtonElement) => document.getElementById(btn.getAttribute('aria-controls')!)!;
  const buttonOf = (panel: HTMLElement) => buttons.find((b) => b.getAttribute('aria-controls') === panel.id)!;
  const tileOf = (btn: HTMLButtonElement) => btn.closest<HTMLElement>('[data-tile]')!;

  function placeTip(btn: HTMLButtonElement) {
    const inner = panelOf(btn).querySelector<HTMLElement>('[data-panel-in]')!;
    const tile = tileOf(btn).getBoundingClientRect();
    const box = inner.getBoundingClientRect();
    inner.style.setProperty('--tip', `${tile.left + tile.width / 2 - box.left}px`);
  }

  function mark(btn: HTMLButtonElement, open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    tileOf(btn).toggleAttribute('data-open', open);
  }

  function animateIn(panel: HTMLElement) {
    if (reduce.matches) return;
    panel.querySelector<HTMLElement>('[data-panel-in]')!.animate(
      [
        { opacity: 0, transform: 'translateY(-10px)', filter: 'blur(4px)' },
        { opacity: 1, transform: 'none', filter: 'blur(0)' },
      ],
      { duration: 280, easing: ease },
    );
    panel.querySelectorAll<HTMLElement>('tbody tr').forEach((row, i) => {
      row.animate(
        [
          { opacity: 0, transform: 'translateY(4px)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 220, delay: 40 + i * 16, easing: ease, fill: 'backwards' },
      );
    });
  }

  function setOpen(btn: HTMLButtonElement, open: boolean) {
    const panel = panelOf(btn);
    mark(btn, open);
    if (open) {
      panel.removeAttribute('hidden');
      placeTip(btn);
      animateIn(panel);
    } else {
      panel.setAttribute('hidden', 'until-found');
    }
  }

  function closeOthers(keep: HTMLButtonElement) {
    for (const b of buttons) if (b !== keep && b.getAttribute('aria-expanded') === 'true') setOpen(b, false);
  }

  for (const btn of buttons) {
    btn.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') setOpen(btn, false);
    });
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      const tile = tileOf(btn);
      const before = tile.getBoundingClientRect().top;
      closeOthers(btn);
      setOpen(btn, open);
      // A panel that closed above this tile would pull the page up.
      const shift = tile.getBoundingClientRect().top - before;
      if (Math.abs(shift) > 1) window.scrollBy({ top: shift, behavior: 'instant' });
      if (!open) return;
      const top = panelOf(btn).getBoundingClientRect().top;
      if (top > window.innerHeight * 0.72) {
        window.scrollBy({ top: top - window.innerHeight * 0.35, behavior: reduce.matches ? 'instant' : 'smooth' });
      }
    });
  }

  for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
    const btn = buttonOf(panel);
    panel.addEventListener('beforematch', () => {
      closeOthers(btn);
      mark(btn, true);
      requestAnimationFrame(() => placeTip(btn));
    });
    panel.querySelector('[data-panel-close]')!.addEventListener('click', () => {
      setOpen(btn, false);
      btn.focus({ preventScroll: true });
      const top = tileOf(btn).getBoundingClientRect().top;
      if (top < 0) window.scrollBy({ top: top - 96, behavior: 'instant' });
    });
    panel.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setOpen(btn, false);
      btn.focus();
    });
    panel.addEventListener('click', (event) => {
      const copy = (event.target as Element).closest<HTMLButtonElement>('[data-copy]');
      if (!copy) return;
      const value = copy.dataset.copy!;
      navigator.clipboard?.writeText(value).then(
        () => {
          copy.setAttribute('data-copied', '');
          if (status) status.textContent = `Skopiowano indeks ${value}`;
          setTimeout(() => copy.removeAttribute('data-copied'), 1400);
        },
        () => {
          if (status) status.textContent = `Indeks ${value}`;
        },
      );
    });
  }

  window.addEventListener('resize', () => {
    const open = buttons.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (open) placeTip(open);
  });

  const fromHash = document.getElementById(decodeURIComponent(location.hash.slice(1)));
  if (fromHash?.matches('[data-panel]')) setOpen(buttonOf(fromHash), true);
</script>

<style>
  .cat {
    scroll-margin-top: 96px;
  }

  .cat + :global(.cat) {
    margin-top: clamp(72px, 9vw, 128px);
  }

  .cat-head {
    display: grid;
    gap: 14px;
    padding: 0 0 40px;
  }

  .cat-title {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 700;
    font-size: clamp(40px, 5vw, 76px);
    line-height: 0.82;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .cat-facts {
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-2);
  }


  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    /* Later tiles fill the row above an open panel, so the panel lands under its tile's row. */
    grid-auto-flow: row dense;
    column-gap: 16px;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-bottom: 40px;
    transition:
      transform 160ms var(--ease),
      opacity 240ms ease;
  }

  /* While one tile is open, the others in its group step back, so the open one stands out. */
  .grid:has(.tile[data-open]) .tile:not([data-open]) {
    opacity: 0.45;
  }

  .tile:has(.tile-btn:active) {
    transform: scale(0.97);
  }

  .tile:has(.tile-btn:focus-visible) {
    z-index: 1;
    outline: 2px solid var(--ink-accent);
    outline-offset: 4px;
  }

  .tile-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 14px;
  }

  .tile-code {
    font-family: var(--display);
    font-stretch: 80%;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .tile-btn {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-align: left;
  }

  .tile-btn::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tile-btn:focus-visible {
    outline: none;
  }

  .tile-spec {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .tile-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .tile-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .pm {
    position: relative;
    display: inline-block;
    width: 11px;
    height: 11px;
  }

  /* Whole-pixel bars, so the rotated bar renders as thin as the flat one. */
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 220ms var(--ease);
  }

  .pm::after {
    transform: rotate(90deg);
  }

  .tile[data-open] .pm::after,
  .pm.is-open::after {
    transform: rotate(0deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .grid:has(.tile[data-open]) .tile:not([data-open]):hover {
      opacity: 1;
    }

    .tile:hover :global(.shot-in) {
      transform: translateY(-3%) scale(1.04);
    }

    .tile:hover .tile-more {
      text-decoration-color: currentColor;
    }
  }

  /* An open tile keeps the zoom and a solid underline, so it stays marked after the pointer leaves. */
  .tile[data-open] :global(.shot-in) {
    transform: translateY(-3%) scale(1.04);
  }

  .tile[data-open] .tile-more {
    text-decoration-color: currentColor;
  }

  .panel {
    grid-column: 1 / -1;
    scroll-margin-top: 96px;
  }

  .panel-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'head table'
      'kit table';
    gap: 32px 64px;
    margin-bottom: 48px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--ink-accent);
    border-bottom: 1px solid var(--line);
  }

  .panel-tip {
    position: absolute;
    top: -14px;
    left: var(--tip, 50%);
    width: 28px;
    height: 14px;
    margin-left: -14px;
    background: var(--ink-accent);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .panel-code {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 700;
    font-size: clamp(44px, 5vw, 72px);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .panel-title {
    margin-top: 14px;
    font-size: 18px;
    line-height: 1.4;
    max-width: 34ch;
  }

  .panel-dims {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 20px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 13px;
  }

  .panel-dims div {
    display: flex;
    gap: 8px;
  }

  .panel-dims dt {
    color: var(--ink-2);
  }

  .panel-h {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .panel-list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.45;
  }

  .panel-list li {
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
  }

  .panel-head {
    grid-area: head;
  }

  .panel-kit {
    grid-area: kit;
  }

  /* Only a wide table scrolls, and only sideways. Rows that slide in must not flash a vertical scrollbar. */
  .panel-table {
    grid-area: table;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  caption {
    padding-bottom: 12px;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-align: left;
    caption-side: top;
  }

  th,
  td {
    padding: 8px 16px 8px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
  }

  thead th {
    vertical-align: bottom;
    font-weight: 400;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.3;
    border-bottom-color: var(--line-2);
  }

  .idx-h span {
    display: block;
    color: var(--ink-2);
  }

  /* Circuits and indexes carry the row. Lengths stay lighter. */
  tbody th {
    font-weight: 600;
    color: var(--ink);
  }

  tbody td {
    color: var(--ink-2);
  }

  .idx {
    position: relative;
    min-height: 28px;
    margin: -2px -6px;
    padding: 2px 6px;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    transition:
      background-color 150ms ease,
      transform 160ms var(--ease);
  }

  .idx:active {
    transform: scale(0.97);
  }

  .idx:focus-visible {
    outline: 2px solid var(--ink-accent);
    outline-offset: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .idx:hover {
      background: var(--surface-2, #ececec);
    }
  }

  .idx[data-copied] {
    background: var(--action);
    color: var(--on-action);
  }

  .idx[data-copied]::after {
    content: 'skopiowano';
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--bg, #fff);
    color: var(--ink-2);
    font-size: 11px;
    white-space: nowrap;
  }

  .panel-close {
    position: absolute;
    top: 20px;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media (max-width: 1099px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .panel-in {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'head'
        'table'
        'kit';
    }
  }

  @media (max-width: 899px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid .tile :global(.shot) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 599px) {
    .grid .tile :global(.shot) {
      aspect-ratio: 1;
    }
  }

  @media (max-width: 720px) {
    .cat-head {
      padding-bottom: 28px;
    }

    .grid {
      column-gap: 8px;
    }

    .tile {
      padding-bottom: 32px;
    }

    .tile-code {
      font-size: 18px;
    }

    .tile-spec {
      font-size: 13px;
    }

    .tile-meta {
      flex-direction: column;
      gap: 6px;
      font-size: 11px;
    }

    .panel-in {
      padding-top: 24px;
    }

    .panel-close {
      top: 12px;
    }
  }
</style>
