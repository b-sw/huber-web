---
import Logo from '../Logo.astro';
import type { NavLink } from './text';

interface Props {
  links: NavLink[];
  cta: NavLink;
}

const { links, cta } = Astro.props;
---

<a class="skip" href="#tresc">Przejdź do treści</a>

<header class="hdr" data-hdr>
  <nav class="bar" aria-label="Główna">
    <a class="home" href="#top" aria-label="Huber – początek strony">
      <Logo height={22} ink="var(--ink)" paper="var(--bg)" />
    </a>

    <ul class="links" role="list" data-links>
      {
        links.map((l) => (
          <li>
            <a href={`#${l.id}`} data-nav={l.id}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="cta" href={`#${cta.id}`} data-nav={cta.id}>{cta.label}</a>

    <button
      class="menu-btn"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="pw-menu"
      data-menu-open
    >
      <span>Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>
  </nav>
</header>

<dialog class="menu" id="pw-menu" aria-labelledby="pw-menu-title" data-menu>
  <div class="menu-bar">
    <span class="menu-logo"><Logo height={22} ink="var(--ink)" paper="var(--bg)" /></span>
    <button class="menu-close" type="button" data-menu-close>
      <span>Zamknij</span>
      <span class="cross" aria-hidden="true"></span>
    </button>
  </div>
  <h2 class="visually-hidden" id="pw-menu-title">Menu</h2>
  <nav aria-label="Menu">
    <ul class="menu-links" role="list">
      {
        [...links, cta].map((l) => (
          <li>
            <a href={`#${l.id}`} data-nav={l.id}>
              <span class="menu-label">{l.label}</span>
              <span class="menu-meta">{l.meta}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>('[data-hdr]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const list = document.querySelector<HTMLElement>('[data-links]')!;
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = [...new Set(navLinks.map((a) => a.dataset.nav!))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null)
    .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));

  let queued = false;
  let active: string | null | undefined;

  function placeIndicator(snap = false) {
    const link = list.querySelector<HTMLElement>('a[aria-current="true"]');
    const width = list.offsetWidth;
    if (!link || !width) {
      list.removeAttribute('data-active');
      return;
    }
    const appearing = !list.hasAttribute('data-active');
    snap ||= appearing;
    list.toggleAttribute('data-snap', snap);
    list.style.setProperty('--ix', `${link.offsetLeft}px`);
    list.style.setProperty('--iw', String(link.offsetWidth / width));
    if (snap) {
      void list.offsetWidth;
      list.removeAttribute('data-snap');
    }
    list.setAttribute('data-active', '');
  }

  function setActive(id: string | null) {
    if (id === active) return;
    active = id;
    for (const a of navLinks) {
      if (a.dataset.nav === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
    placeIndicator();
  }

  function update() {
    queued = false;
    const y = window.scrollY;
    const bar = header.offsetHeight;
    const heroBox = hero?.getBoundingClientRect();

    header.toggleAttribute('data-scrolled', heroBox ? heroBox.top < bar - 1 : y > 0);

    const line = window.innerHeight * 0.35;
    const atBottom = window.innerHeight + y >= document.documentElement.scrollHeight - 2;
    let current: string | null = null;
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
    if (atBottom && sections.length) current = sections[sections.length - 1]!.id;
    setActive(current);
  }

  function queue() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  }

  window.addEventListener('scroll', queue, { passive: true });
  window.addEventListener('resize', queue);
  new ResizeObserver(() => placeIndicator(true)).observe(list);
  update();

  openBtn.addEventListener('click', () => {
    menu.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
  });
  menu.addEventListener('close', () => openBtn.setAttribute('aria-expanded', 'false'));
  menu.querySelector('[data-menu-close]')!.addEventListener('click', () => menu.close());
  menu.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.close();
  });
  window.matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
    if (event.matches && menu.open) menu.close();
  });
</script>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: 8px;
    z-index: 100;
    padding: 10px 14px;
    background: var(--action);
    color: var(--on-action);
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  .hdr {
    --bar: 64px;
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--bar);
    color: var(--ink);
    background: color-mix(in oklab, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }

  .hdr[data-scrolled] {
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 100%;
    padding: 0 var(--pad);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
  }

  .links {
    --ix: 0px;
    --iw: 0;
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .menu-btn,
  .menu-close {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: transform 160ms var(--ease);
  }

  .links a {
    color: var(--ink-2);
    transition:
      color 150ms ease,
      transform 160ms var(--ease);
  }

  .links a[aria-current='true'] {
    color: var(--ink);
  }

  .links::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 10px;
    width: 100%;
    height: 1.5px;
    background: var(--ink-accent);
    transform: translateX(var(--ix)) scaleX(var(--iw));
    transform-origin: left;
    opacity: 0;
    transition:
      transform 280ms cubic-bezier(0.77, 0, 0.175, 1),
      opacity 160ms ease;
    pointer-events: none;
  }

  .links[data-active]::after {
    opacity: 1;
  }

  .links[data-snap]::after {
    transition: none;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 6px;
    background: var(--action);
    color: var(--on-action);
    font-family: var(--display);
    font-stretch: 85%;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 160ms var(--ease),
      color 200ms ease,
      background-color 200ms ease;
  }

  .menu-btn,
  .menu-close {
    gap: 10px;
    margin-right: -10px;
    padding: 0 10px;
    border: 0;
    background: none;
    color: inherit;
  }

  .menu-btn {
    display: none;
  }

  .burger,
  .cross {
    position: relative;
    width: 18px;
    height: 10px;
  }

  .burger::before,
  .burger::after,
  .cross::before,
  .cross::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
  }

  .burger::before {
    top: 0;
  }

  .burger::after {
    bottom: 0;
  }

  .cross {
    top: -1px;
  }

  .cross::before,
  .cross::after {
    top: calc(50% - 0.75px);
  }

  .cross::before {
    transform: rotate(45deg);
  }

  .cross::after {
    transform: rotate(-45deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      color: var(--ink);
    }

    .cta:hover {
      background: var(--action-hover);
    }
  }

  .links a:active,
  .cta:active,
  .menu-btn:active,
  .menu-close:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .links::after {
      transition: opacity 160ms ease;
    }
  }

  @media (max-width: 959px) {
    .hdr {
      --bar: 56px;
    }

    .menu-btn {
      display: inline-flex;
    }

    .links,
    .cta {
      display: none;
    }
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--pad) 32px;
    border: 0;
    background: var(--bg, #fff);
    color: var(--ink);
    overflow-y: auto;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 160ms var(--ease),
      transform 160ms var(--ease),
      overlay 160ms allow-discrete,
      display 160ms allow-discrete;
  }

  .menu[open] {
    opacity: 1;
    transform: none;
    transition-duration: 240ms;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .menu-logo {
    display: inline-flex;
  }

  .menu-links {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .menu-links a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0 12px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .menu-label {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 700;
    font-size: 44px;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .menu-links a[aria-current='true'] .menu-label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .menu-meta {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
    text-align: right;
  }
</style>
