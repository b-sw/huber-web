---
// Heating circuits drawn behind one section. A warm spot drifts over the pipes and follows the cursor.
// Two warm copies of the pipes sit inside round lenses. A lens moves with transform and its content
// moves the opposite way, so the warm pipes stay aligned with the cool ones.
import { PLAN_H, PLAN_W, floorPlan } from './pipes';

interface Props {
  id: string;
  // Hides the pipes behind text on one side of the section.
  fade?: 'left' | 'right' | 'none';
}

const { id, fade = 'none' } = Astro.props;
const paths = floorPlan();
const viewBox = `0 0 ${PLAN_W} ${PLAN_H}`;
const pipesId = `${id}-pipes`;
---

<div class="loops" data-loops data-fade={fade} aria-hidden="true">
  <svg class="pipes" viewBox={viewBox} preserveAspectRatio="xMidYMid slice" focusable="false">
    <g id={pipesId} fill="none">
      {paths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
    </g>
  </svg>
  <div class="heat heat--glow" data-heat="glow">
    <div class="heat-inner">
      <svg class="warm" viewBox={viewBox} preserveAspectRatio="xMidYMid slice" focusable="false"><use href={`#${pipesId}`} /></svg>
    </div>
  </div>
  <div class="heat heat--core" data-heat="core">
    <div class="heat-inner">
      <svg class="warm" viewBox={viewBox} preserveAspectRatio="xMidYMid slice" focusable="false"><use href={`#${pipesId}`} /></svg>
    </div>
  </div>
</div>

<style>
  .loops {
    --cx: 70cqw;
    --cy: 50cqh;
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    container-type: size;
  }

  .loops[data-fade='left'] {
    mask-image: linear-gradient(90deg, transparent 0%, transparent 56%, #000 78%);
  }

  .loops[data-fade='right'] {
    mask-image: linear-gradient(270deg, transparent 0%, transparent 56%, #000 78%);
  }

  .pipes,
  .heat-inner {
    position: absolute;
    left: 0;
    top: 0;
    width: 100cqw;
    height: 100cqh;
  }

  .pipes {
    stroke: var(--loops-line, #d6d3c8);
    stroke-width: 1;
  }

  .warm {
    width: 100%;
    height: 100%;
    stroke: var(--loops-heat, #ff5a1f);
    stroke-width: 1.6;
  }

  .heat {
    --r: 170px;
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    overflow: hidden;
    border-radius: 50%;
    mask-image: radial-gradient(closest-side, #000 25%, rgb(0 0 0 / 0.55) 60%, transparent 100%);
    transform: translate(calc(var(--cx) - var(--r)), calc(var(--cy) - var(--r)));
    opacity: 0.8;
    transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }

  .heat-inner {
    transform: translate(calc(var(--r) - var(--cx)), calc(var(--r) - var(--cy)));
    will-change: transform;
  }

  .heat--glow {
    --r: 320px;
    opacity: 0.4;
  }

  .heat--glow .warm {
    stroke-width: 1.2;
  }

  .loops[data-hot] .heat--core {
    opacity: 1;
  }

  .loops[data-hot] .heat--glow {
    opacity: 0.55;
  }
</style>

<script>
  // One loop per section owns the warm spot. It drifts along a slow path by itself
  // and follows the cursor while the visitor points at the section.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const AUTO_RESUME_MS = 1500;

  document.querySelectorAll<HTMLElement>('[data-loops]').forEach((loops) => {
    if (still) return;
    const host = loops.parentElement!;
    const fade = loops.dataset.fade;
    // The drift stays where the pipes are visible, not behind the text.
    const band = fade === 'left' ? [0.66, 0.95] : fade === 'right' ? [0.05, 0.34] : [0.1, 0.9];
    const lenses = Array.from(loops.querySelectorAll<HTMLElement>('[data-heat]'), (el) => ({
      el,
      inner: el.firstElementChild as HTMLElement,
      r: el.offsetWidth / 2,
      ease: el.dataset.heat === 'core' ? 0.16 : 0.06,
      x: 0,
      y: 0,
    }));
    const target = { x: 0, y: 0 };
    let pointerInside = false;
    let lastPointer = 0;
    let inView = false;
    let frame = 0;

    const autoPoint = (t: number) => {
      const w = loops.clientWidth;
      const h = loops.clientHeight;
      const mid = (band[0]! + band[1]!) / 2;
      const span = (band[1]! - band[0]!) / 2;
      return {
        x: w * (mid + span * Math.sin(t * 0.00023)),
        y: h * (0.5 + 0.3 * Math.sin(t * 0.00037 + 0.8)),
      };
    };

    const step = (now: number) => {
      frame = 0;
      if (!pointerInside && now - lastPointer > AUTO_RESUME_MS) {
        const p = autoPoint(now);
        target.x = p.x;
        target.y = p.y;
      }
      for (const lens of lenses) {
        lens.x += (target.x - lens.x) * lens.ease;
        lens.y += (target.y - lens.y) * lens.ease;
        const ox = lens.x - lens.r;
        const oy = lens.y - lens.r;
        lens.el.style.transform = `translate3d(${ox}px, ${oy}px, 0)`;
        lens.inner.style.transform = `translate3d(${-ox}px, ${-oy}px, 0)`;
      }
      if (inView && !document.hidden) frame = requestAnimationFrame(step);
    };
    const wake = () => {
      if (!frame && inView && !document.hidden) frame = requestAnimationFrame(step);
    };

    const p0 = autoPoint(performance.now());
    lenses.forEach((lens) => {
      lens.x = p0.x;
      lens.y = p0.y;
    });
    loops.dataset.hot = '';

    host.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const rect = loops.getBoundingClientRect();
      target.x = event.clientX - rect.left;
      target.y = event.clientY - rect.top;
      pointerInside = true;
      lastPointer = performance.now();
    });
    host.addEventListener('pointerleave', () => {
      pointerInside = false;
      lastPointer = performance.now();
    });
    new IntersectionObserver((entries) => {
      inView = entries.some((e) => e.isIntersecting);
      wake();
    }).observe(loops);
    document.addEventListener('visibilitychange', wake);
    window.addEventListener('resize', () => lenses.forEach((lens) => (lens.r = lens.el.offsetWidth / 2)));
  });
</script>
