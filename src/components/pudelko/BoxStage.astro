---
import '../../styles/archivo-subset.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import { circuitRange, configFloor, getProduct, products } from '../../data/products';
import grain from '../../assets/textures/kraft-grain.webp';
import mottle from '../../assets/textures/kraft-mottle.webp';
import XrayLayer from './XrayLayer.astro';
import ManifoldDrawing from './ManifoldDrawing.astro';
import {
  TAPE,
  VB,
  front,
  photoTransform,
  pts,
  side,
  silhouette,
  silhouetteClip,
  tapeOutline,
  tapePrint,
  tapes,
  top,
} from './geometry';

const product = getProduct('rw-ezmptr');
const row = product.rows.find((r) => r.circuits === 5)!;
const [index] = row.indexes;
const range = circuitRange(products);

// Decorative barcode derived from the index and the dimensions.
const bars: { x: number; w: number }[] = [];
let bx = 0;
for (const ch of `${index}${row.L}${row.H}`.repeat(2)) {
  const code = ch.charCodeAt(0);
  for (const w of [1 + (code % 3), 2 + (code % 2), 1 + ((code >> 2) % 3)]) {
    bars.push({ x: bx, w: w * 1.6 });
    bx += w * 1.6 + 2.4;
  }
}

// Cursor lenses, largest first. Each one holds its own copy of the X-ray, moved only with transforms.
const lenses = [15, 11.5, 8.5, 6];
const stamp = { x: 90, y: 166, r: 84 };
const contents = ['rozdzielacz RW-EZMPTR, 5 obwodów', 'pompa WILO Yonos PARA', 'zawór ESBE VTA322', '2 termometry', '2 uchwyty montażowe'];
---

<div class="stage-wrap" data-stage-wrap>
  <figure class="stage" data-stage>
    <svg class="art" viewBox={`0 0 ${VB.w} ${VB.h}`} aria-hidden="true">
      <defs>
        <filter id="shadow-soft" x="-10%" y="-60%" width="120%" height="220%">
          <feGaussianBlur stdDeviation="10"></feGaussianBlur>
        </filter>
        <filter id="shadow-tight" x="-10%" y="-60%" width="120%" height="220%">
          <feGaussianBlur stdDeviation="2"></feGaussianBlur>
        </filter>
        <linearGradient id="flute" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#3b2914"></stop>
          <stop offset="0.5" stop-color="#f5dcb5"></stop>
          <stop offset="1" stop-color="#3b2914"></stop>
        </linearGradient>
        {/* Corrugated board: the flutes under the liner show as faint stripes along the height of each panel. */}
        <pattern id="flutes-front" width="14" height="10" patternUnits="userSpaceOnUse">
          <rect width="14" height="10" fill="url(#flute)"></rect>
        </pattern>
        <pattern id="flutes-side" width="9" height="10" patternUnits="userSpaceOnUse">
          <rect width="9" height="10" fill="url(#flute)"></rect>
        </pattern>
        <pattern id="flutes-top" width="14" height="10" patternUnits="userSpaceOnUse" patternTransform="skewX(-40)">
          <rect width="14" height="10" fill="url(#flute)"></rect>
        </pattern>
        <linearGradient id="front-light" x1="0" y1="140" x2="0" y2="740" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff" stop-opacity="0.14"></stop>
          <stop offset="0.35" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="0.96" stop-color="#2a1a0c" stop-opacity="0.12"></stop>
          <stop offset="1" stop-color="#2a1a0c" stop-opacity="0.24"></stop>
        </linearGradient>
        <linearGradient id="front-falloff" x1="30" y1="0" x2="1090" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff" stop-opacity="0.07"></stop>
          <stop offset="0.55" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="1" stop-color="#2a1a0c" stop-opacity="0.08"></stop>
        </linearGradient>
        <linearGradient id="top-light" x1="30" y1="0" x2="1174" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff" stop-opacity="0.16"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="side-light" x1="0" y1="40" x2="0" y2="740" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff" stop-opacity="0.05"></stop>
          <stop offset="1" stop-color="#2a1a0c" stop-opacity="0.22"></stop>
        </linearGradient>
        <linearGradient id="side-turn" x1="1090" y1="0" x2="1174" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff" stop-opacity="0.14"></stop>
          <stop offset="0.14" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="1" stop-color="#2a1a0c" stop-opacity="0.1"></stop>
        </linearGradient>
      </defs>

      <polygon points="44,738 1090,738 1172,640 1194,644 1108,752 60,754" fill="#2a1f14" opacity="0.2" filter="url(#shadow-soft)"></polygon>
      <polygon points="32,738.5 1090,738.5 1173,639.5 1177,641 1093,744 34,744" fill="#1c140c" opacity="0.45" filter="url(#shadow-tight)"></polygon>

      <polygon points={pts(front)} fill="#c69c6d"></polygon>
      <polygon points={pts(top)} fill="#d7b386"></polygon>
      <polygon points={pts(side)} fill="#a67c50"></polygon>
      <polygon points={pts(front)} fill="url(#flutes-front)" opacity="0.06"></polygon>
      <polygon points={pts(top)} fill="url(#flutes-top)" opacity="0.05"></polygon>
      <polygon points={pts(side)} fill="url(#flutes-side)" opacity="0.06"></polygon>
      <polygon points={pts(front)} fill="url(#front-light)"></polygon>
      <polygon points={pts(front)} fill="url(#front-falloff)"></polygon>
      <polygon points={pts(top)} fill="url(#top-light)"></polygon>
      <polygon points={pts(side)} fill="url(#side-light)"></polygon>
      <polygon points={pts(side)} fill="url(#side-turn)"></polygon>
    </svg>

    <div class="board board-mottle" style={`background-image:url(${mottle.src});clip-path:${silhouetteClip}`}></div>
    <div class="board board-grain" style={`background-image:url(${grain.src});clip-path:${silhouetteClip}`}></div>

    {/* Huber does not print on boxes: the brand comes only on the client's label and tape.
        After the board layers, so the paper label gets no grain. */}
    <div class="label" aria-hidden="true">
      <p class="label-brand" data-brand data-brand-fit>TWOJA MARKA</p>
      <p class="label-sub">Rozdzielacz do podłogówki z układem mieszającym</p>
      <dl class="label-spec">
        <div><dt>Model</dt><dd>{product.code}</dd></div>
        <div><dt>Obwody</dt><dd>{row.circuits}</dd></div>
        <div><dt>Indeks</dt><dd>{index}</dd></div>
      </dl>
      <svg class="label-code" viewBox={`0 0 ${bx} 40`} preserveAspectRatio="none">
        {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="40" />)}
      </svg>
      <p class="label-foot">{index} · Wyprodukowano w Polsce</p>
    </div>

    <svg class="art" viewBox={`0 0 ${VB.w} ${VB.h}`} aria-hidden="true">
      <defs>
        {/* In the frame of a tape, so one gradient lights every strip across its width. */}
        <linearGradient id="tape-gloss" x1="0" y1={-TAPE.w / 2} x2="0" y2={TAPE.w / 2} gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff" stop-opacity="0.1"></stop>
          <stop offset="0.24" stop-color="#fff" stop-opacity="0.7"></stop>
          <stop offset="0.42" stop-color="#fff" stop-opacity="0.08"></stop>
          <stop offset="0.8" stop-color="#fff" stop-opacity="0.3"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        {
          tapes.flatMap((tape, t) =>
            tape.faces.map((face, f) => (
              <clipPath id={`tape-${t}-${f}`}>
                <polygon points={pts(tapeOutline(face))}></polygon>
              </clipPath>
            )),
          )
        }
        <linearGradient id="fold-light" x1="0" y1="140" x2="0" y2="148" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff" stop-opacity="0.2"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <radialGradient id="sticker-gloss" cx="0.34" cy="0.26" r="0.7">
          <stop offset="0" stop-color="#fff" stop-opacity="0.16"></stop>
          <stop offset="0.7" stop-color="#fff" stop-opacity="0"></stop>
        </radialGradient>
        <clipPath id="box-clip">
          <polygon points={pts(silhouette)}></polygon>
        </clipPath>
        <clipPath id="sticker-clip">
          <circle cx={stamp.x} cy={stamp.y} r={stamp.r}></circle>
        </clipPath>
        {/* Cuts the drawing out around the tape and the sticker, with a small gap, so their print stays clear. */}
        <mask id="drawing-mask" maskUnits="userSpaceOnUse" x="0" y="0" width={VB.w} height={VB.h}>
          <rect width={VB.w} height={VB.h} fill="#fff"></rect>
          {
            tapes.flatMap((tape) =>
              tape.faces.map((face) => (
                <polygon points={pts(tapeOutline(face))} transform={face.m} class="cutout"></polygon>
              )),
            )
          }
          <circle cx={stamp.x} cy={stamp.y} r={stamp.r} class="cutout"></circle>
        </mask>
        <filter id="sticker-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="1.5" dy="3" stdDeviation="2.2" flood-color="#2a1408" flood-opacity="0.35"></feDropShadow>
        </filter>
      </defs>

      {/* The seam strip goes on first, the cross strip over it. */}
      {
        tapes.map((tape, t) =>
          tape.faces.map((face, f) => (
            <g transform={face.m} class={`tape tape-${face.face}`}>
              <polygon points={pts(tapeOutline(face))} class="tape-base"></polygon>
              {t === 0 && face.face === 'top' && (
                <line x1={face.from} y1="0" x2={face.to} y2="0" class="tape-groove"></line>
              )}
              <g clip-path={`url(#tape-${t}-${f})`} class="tape-ink">
                {tapePrint(tape, face).map((s) => (
                  <>
                    <text x={s} y="0" dy="0.35em" text-anchor="middle" data-brand data-brand-fit-svg={TAPE.text}>TWOJA MARKA</text>
                    <circle cx={s + TAPE.repeat / 2} cy="0" r="3"></circle>
                  </>
                ))}
              </g>
              <polygon points={pts(tapeOutline(face))} fill="url(#tape-gloss)"></polygon>
              <polygon points={pts(tapeOutline(face))} class="tape-edge"></polygon>
            </g>
          )),
        )
      }

      <rect x={front[0][0]} y={front[0][1]} width={front[1][0] - front[0][0]} height="8" fill="url(#fold-light)"></rect>
      <g fill="none" stroke-linecap="round">
        <line x1={front[0][0]} y1={front[0][1]} x2={front[1][0]} y2={front[1][1]} stroke="#f8e6c8" stroke-opacity="0.8" stroke-width="1.6"></line>
        <line x1={front[1][0]} y1={front[1][1]} x2={top[2][0]} y2={top[2][1]} stroke="#f8e6c8" stroke-opacity="0.6" stroke-width="1.4"></line>
        <line x1={top[0][0]} y1={top[0][1]} x2={top[3][0]} y2={top[3][1]} stroke="#f3dcb9" stroke-opacity="0.45" stroke-width="1.2"></line>
        <line x1={front[0][0]} y1={front[0][1]} x2={front[3][0]} y2={front[3][1]} stroke="#f3dcb9" stroke-opacity="0.35" stroke-width="1.2"></line>
        <line x1={front[1][0]} y1={front[1][1]} x2={front[2][0]} y2={front[2][1]} stroke="#ead0a6" stroke-opacity="0.4"></line>
      </g>

      {/* The sticker wraps over the box edges, and the part on the lid faces the light. */}
      <g clip-path="url(#box-clip)" class="stamp">
        <g transform={`translate(${stamp.x} ${stamp.y}) rotate(-10)`}>
          <circle r="84" fill="#f26a21" filter="url(#sticker-shadow)"></circle>
          <circle r="75" fill="none" stroke="#161412" stroke-width="1.4" stroke-dasharray="2 3"></circle>
          <text y="-46" text-anchor="middle" class="stamp-label small">PONAD</text>
          <text y="4" text-anchor="middle" class="stamp-num">{configFloor}</text>
          <text y="30" text-anchor="middle" class="stamp-label">KONFIGURACJI</text>
          <text y="50" text-anchor="middle" class="stamp-label small">{range.min}–{range.max} OBWODÓW</text>
          <circle r="84" fill="url(#sticker-gloss)"></circle>
          <circle r="83.5" fill="none" stroke="#7a2c07" stroke-opacity="0.25"></circle>
        </g>
        <polygon points={pts(top)} fill="#fff" opacity="0.16" clip-path="url(#sticker-clip)"></polygon>
        <line x1={front[0][0]} y1={front[0][1]} x2="200" y2={front[0][1]} stroke="#fff" stroke-opacity="0.35" clip-path="url(#sticker-clip)"></line>
      </g>

      {/* Not printed on the box. It sits above all box art. */}
      <g mask="url(#drawing-mask)">
        <g transform={photoTransform}>
          <ManifoldDrawing />
        </g>
      </g>
    </svg>

    <div class="xray-full" data-xray-full>
      <XrayLayer id="xray-full" withList />
    </div>

    {
      lenses.map((r, i) => (
        <div class="lens" data-lens style={`--r: ${r}cqw`}>
          <div class="lens-inner">
            <XrayLayer id={`xray-lens-${i}`} />
          </div>
        </div>
      ))
    }

    {/* A real button over the whole box: the label and tape text stay decoration, the button has its own name. */}
    <button type="button" class="stage-btn" data-stage-btn aria-pressed="false">
      <span class="visually-hidden">Zajrzyj do środka pudełka z rozdzielaczem {product.code}</span>
    </button>
  </figure>

  <ul class="contents-below" role="list">
    {contents.map((c) => <li>{c}</li>)}
    <li>Indeks {index}</li>
  </ul>
</div>

<script>
  // One loop owns the lenses. Its target comes from the cursor while the visitor points at the box,
  // and from a slow automatic path while nobody does, so the box always shows that it hides something.
  const wrap = document.querySelector<HTMLElement>('[data-stage-wrap]');
  const stage = wrap?.querySelector<HTMLElement>('[data-stage]');
  const button = stage?.querySelector<HTMLButtonElement>('[data-stage-btn]');

  if (wrap && stage && button) {
    stage.setAttribute('data-js', '');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
    // Over the label the lenses close, so the brand stays readable.
    const LABEL_ZONE = 0.62;
    const AUTO_RESUME_MS = 1800;
    const FOLLOW = [0.3, 0.22, 0.18, 0.15];

    const lenses = [...stage.querySelectorAll<HTMLElement>('[data-lens]')].map((el, i) => ({
      el,
      inner: el.firstElementChild as HTMLElement,
      r: 0,
      x: 0,
      y: 0,
      s: 0,
      follow: FOLLOW[i] ?? 0.15,
    }));

    let w = 0;
    let h = 0;
    const measure = () => {
      w = stage.clientWidth;
      h = stage.clientHeight;
      lenses.forEach((lens) => (lens.r = lens.el.offsetWidth / 2));
    };

    const target = { x: 0, y: 0, open: 0 };
    let pointerInside = false;
    let lastPointer = 0;
    let isOpen = false;
    let inView = false;
    let frame = 0;
    const start = performance.now();

    const autoPoint = (t: number) => ({
      x: w * (0.31 + 0.2 * Math.sin(t * 0.00042) + 0.05 * Math.sin(t * 0.0011)),
      y: h * (0.47 + 0.15 * Math.sin(t * 0.00061 + 1.2)),
    });

    // Whole device pixels keep the X-ray copy at an exact position. Fractional offsets make some Windows GPUs
    // draw hairline seams through the lens.
    const snap = (v: number) => Math.round(v * devicePixelRatio) / devicePixelRatio;
    const place = (lens: (typeof lenses)[number]) => {
      const s = Math.max(lens.s, 0.001);
      const x = snap(lens.x);
      const y = snap(lens.y);
      lens.el.style.opacity = lens.s < 0.02 ? '0' : '1';
      lens.el.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${s}) translate3d(${-lens.r}px, ${-lens.r}px, 0)`;
      lens.inner.style.transform = `translate3d(${lens.r}px, ${lens.r}px, 0) scale(${1 / s}) translate3d(${-x}px, ${-y}px, 0)`;
    };

    const tick = (now: number) => {
      frame = 0;
      const auto = !pointerInside && now - lastPointer > AUTO_RESUME_MS;
      if (auto) {
        const p = autoPoint(now - start);
        target.x = p.x;
        target.y = p.y;
      }
      const inLabel = target.x > w * LABEL_ZONE;
      const want = isOpen || inLabel ? 0 : auto ? 0.85 : pointerInside ? 1 : 0;

      let moving = false;
      lenses.forEach((lens, i) => {
        const lead = i === 0 ? target : lenses[i - 1]!;
        lens.x += (lead.x - lens.x) * lens.follow;
        lens.y += (lead.y - lens.y) * lens.follow;
        lens.s += (want - lens.s) * 0.12;
        // Settle on the exact size, so a resting lens is not scaled by a fraction.
        if (Math.abs(want - lens.s) < 0.004) lens.s = want;
        if (Math.abs(lead.x - lens.x) > 0.3 || Math.abs(lead.y - lens.y) > 0.3 || Math.abs(want - lens.s) > 0.004) moving = true;
        place(lens);
      });
      const idle = !pointerInside && !isOpen;
      if (inView && !document.hidden && (moving || idle)) frame = requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!frame && inView) frame = requestAnimationFrame(tick);
    };

    const jumpLenses = (x: number, y: number) => {
      lenses.forEach((lens) => {
        lens.x = x;
        lens.y = y;
      });
    };

    const setOpen = (next: boolean) => {
      isOpen = next;
      button.setAttribute('aria-pressed', String(next));
      wrap.toggleAttribute('data-open', next);
      wake();
    };
    button.addEventListener('click', () => {
      lastPointer = performance.now();
      setOpen(!isOpen);
    });

    measure();
    window.addEventListener('resize', measure);

    if (reduceMotion) {
      // No moving lenses: the button opens and closes the whole box.
      lenses.forEach((lens) => lens.el.remove());
    } else {
      const local = (e: PointerEvent) => {
        const rect = stage.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
      };
      if (finePointer) {
        stage.addEventListener('pointerenter', (e) => {
          pointerInside = true;
          const p = local(e);
          if (lenses[0]!.s < 0.05) jumpLenses(p.x, p.y);
          target.x = p.x;
          target.y = p.y;
          wake();
        });
        stage.addEventListener('pointermove', (e) => {
          const p = local(e);
          target.x = p.x;
          target.y = p.y;
          lastPointer = performance.now();
          wake();
        });
        stage.addEventListener('pointerleave', () => {
          pointerInside = false;
          lastPointer = performance.now();
          wake();
        });
      }

      const p0 = autoPoint(0);
      jumpLenses(p0.x, p0.y);
      new IntersectionObserver((entries) => {
        inView = entries.some((e) => e.isIntersecting);
        wake();
      }).observe(stage);
      document.addEventListener('visibilitychange', wake);
    }
  }
</script>

<style>
  .stage {
    position: relative;
    margin: 0;
    aspect-ratio: 1200 / 760;
    container-type: inline-size;
  }

  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .board {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .board-mottle {
    background-size: 100% 100%;
    mix-blend-mode: soft-light;
    opacity: 0.7;
  }

  .board-grain {
    background-size: calc(100cqw * 320 / 1200);
    mix-blend-mode: soft-light;
  }

  /* White polypropylene tape. Each face takes the light of the board under it. */
  .tape-base {
    fill: #f2ede4;
  }

  .tape-front .tape-base {
    fill: #e6dfd3;
  }

  .tape-side .tape-base {
    fill: #c8bead;
  }

  .tape-groove {
    stroke: #6b5843;
    stroke-opacity: 0.22;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .tape-ink {
    fill: #1d1a17;
    font-family: 'Archivo Subset', sans-serif;
    font-stretch: 72%;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .cutout {
    fill: #000;
    stroke: #000;
    stroke-width: 14;
    stroke-linejoin: round;
  }

  .tape-edge {
    fill: none;
    stroke: #4a3520;
    stroke-opacity: 0.28;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .stamp {
    transition: opacity 240ms ease;
  }

  .stamp text {
    fill: #161412;
  }

  .stamp-num {
    font-family: 'Archivo Subset', sans-serif;
    font-stretch: 72%;
    font-size: 60px;
    font-weight: 800;
  }

  .stamp-label {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 17px;
    font-weight: 600;
  }

  .stamp-label.small {
    font-size: 14px;
  }

  /* The sticker is on the outside of the carton, so the X-ray view does not show it. */
  .stage-wrap[data-open] .stamp {
    opacity: 0;
  }

  .label {
    position: absolute;
    left: 66.6%;
    top: 30.4%;
    width: 22.6%;
    display: flex;
    flex-direction: column;
    padding: 1.5cqw 1.5cqw 1.2cqw;
    border-radius: 0.3cqw;
    background: linear-gradient(170deg, #fbf9f4, #efeae1);
    color: #1d1a17;
    box-shadow:
      0 0.08cqw 0.16cqw rgb(42 20 8 / 0.32),
      0.2cqw 0.6cqw 1.2cqw -0.2cqw rgb(42 20 8 / 0.22);
    /* Set on by hand. */
    rotate: -0.7deg;
    pointer-events: none;
  }

  .label-brand {
    font-family: 'Archivo Subset', sans-serif;
    font-stretch: 72%;
    font-weight: 800;
    font-size: calc(5.4cqw * var(--fit, 1));
    line-height: 1;
    letter-spacing: -0.01em;
    overflow: hidden;
  }

  .label-sub {
    margin-top: 1.2cqw;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 1.2cqw;
    font-weight: 600;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.03em;
