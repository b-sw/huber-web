---
import '../../styles/archivo-subset.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../../styles/reveal.css';
import '../../styles/palette.css';
import '../../styles/links.css';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VariantNav from '../../components/VariantNav.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import BoxStage from '../../components/pudelko/BoxStage.astro';
import ManifoldExploded from '../../components/oem/ManifoldExploded.astro';
import HeatLoops from '../../components/heat/HeatLoops.astro';
import Header from '../../components/pudelko-witryna/Header.astro';
import Category from '../../components/pudelko-witryna/Category.astro';
import { configurations, mailto, type NavLink } from '../../components/pudelko-witryna/text';
import { company } from '../../data/company';
import { byMaterial, circuitRange, materials, productImage, productUrl, products } from '../../data/products';
import factory from '../../assets/photos/factory.jpg';

const all = circuitRange(products);
const brass = byMaterial('mosiadz');
const inox = byMaterial('inox');
const brassRange = circuitRange(brass);
const inoxRange = circuitRange(inox);

const links: NavLink[] = [
  {
    id: 'mosiadz',
    label: 'Mosiądz',
    meta: `${configurations(brass.length)} · ${brassRange.min}–${brassRange.max} obwodów`,
  },
  {
    id: 'inox',
    label: 'Inox',
    meta: `${configurations(inox.length)} · ${inoxRange.min}–${inoxRange.max} obwodów`,
  },
  { id: 'oem', label: 'OEM', meta: 'Pod Twoją marką' },
  { id: 'o-firmie', label: 'O firmie', meta: `Od ${company.foundingYear}` },
];
const contact: NavLink = { id: 'kontakt', label: 'Kontakt', meta: company.phone };

const steps = [
  { title: 'Konfiguracja', text: 'Wybierasz zestawy z katalogu albo opisujesz własne wyposażenie.' },
  { title: 'Wycena', text: 'Przygotowujemy ofertę dla Twoich ilości i terminów.' },
  { title: 'Produkcja', text: 'Wykonujemy rozdzielacze z Twoim oznaczeniem na belce i pakujemy je w Twoje opakowanie.' },
  { title: 'Dostawa', text: 'Dostarczamy terminowo i pilnujemy ciągłości kolejnych dostaw.' },
];

const customMail = mailto(company.email, 'Rozdzielacz na zamówienie');

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Rozdzielacze do ogrzewania podłogowego Huber',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: `Rozdzielacz ${p.code}`,
      description: p.title,
      sku: p.code,
      brand: { '@type': 'Brand', name: company.name },
      material: materials[p.material].label,
      url: productUrl(p.slug),
    },
  })),
};

const year = new Date().getFullYear();
---

<Base
  title="Rozdzielacze do podłogówki – producent i OEM pod Twoją marką | Huber"
  description={`Producent rozdzielaczy do ogrzewania podłogowego od ${company.foundingYear} roku. ${products.length} konfiguracji z mosiądzu i inoxu, ${all.min}–${all.max} obwodów. Produkcja OEM pod Twoją marką dla hurtowni i dystrybutorów.`}
  themeColor="#fff8f5"
  ogImage={productImage('rw-ezmptr')}
  jsonLd={[itemList]}
>
  <script is:inline slot="head">document.documentElement.classList.add('reveal-on');</script>
  <VariantNav slug="pudelko-witryna" />
  <Header links={links} cta={contact} />

  <main id="tresc">
    <section class="hero" id="top" data-hero aria-labelledby="hero-h">
      <h1 class="hero-title" id="hero-h">
        Rozdzielacze do podłogówki <span class="tape">pod Twoją marką</span>
      </h1>
      <svg class="tape-defs" aria-hidden="true" focusable="false">
        <filter id="tape-rough" x="-4%" y="-25%" width="108%" height="150%">
          <feTurbulence type="fractalNoise" baseFrequency="0.018 0.11" numOctaves="3" seed="7" />
          <feDisplacementMap in="SourceGraphic" scale="11" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </svg>
      <div class="hero-stage">
        <BoxStage />
      </div>
      <p class="hero-hint" aria-hidden="true">
        <span class="hint-closed">
          <span class="on-fine">Kliknij pudełko, żeby zajrzeć do środka.</span>
          <span class="on-touch">Dotknij pudełka, żeby zajrzeć do środka.</span>
        </span>
        <span class="hint-open">
          <span class="on-fine">Kliknij pudełko, żeby je zamknąć.</span>
          <span class="on-touch">Dotknij pudełka, żeby je zamknąć.</span>
        </span>
      </p>
      <div class="hero-foot">
        <p class="hero-lead">
          {products.length} konfiguracji z mosiądzu i inoxu, od {all.min} do {all.max} obwodów. Każdą wykonamy też pod
          Twoją marką.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#asortyment">
            Zobacz asortyment
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--line" href="#oem">Jak działa OEM</a>
        </div>
      </div>
    </section>

    <section class="sec range" id="asortyment" aria-labelledby="range-h">
      <p class="kicker" data-reveal>Asortyment</p>
      <div class="sec-intro">
        <h2 class="statement" id="range-h" data-reveal="words">
          {products.length} konfiguracji z mosiądzu i inoxu. <span class="muted">Od {all.min} do {all.max} obwodów.</span>
        </h2>
        <p class="sec-lead" data-reveal style="--d: 180">
          <span class="on-fine">Kliknij zestaw, żeby zobaczyć indeksy i wymiary.</span>
          <span class="on-touch">Dotknij zestawu, żeby zobaczyć indeksy i wymiary.</span>
        </p>
      </div>

      <Category material="mosiadz" />
      <Category material="inox" />

      <aside class="custom" aria-label="Konfiguracje na zamówienie" data-reveal>
        <p>Nie ma tu Twojej konfiguracji? Wykonamy ją na zamówienie.</p>
        <a class="btn btn--line" href={customMail}>
          Opisz, czego potrzebujesz
          <Icon name="arrow-up-right" size={18} />
        </a>
      </aside>
      <p class="visually-hidden" aria-live="polite" data-copy-status></p>
    </section>

    <section class="sec oem" id="oem" aria-labelledby="oem-h">
      <p class="kicker" data-reveal><span class="flag">Nowość</span> OEM</p>
      <h2 class="mega rise" id="oem-h" data-reveal="rise"><span>Pod Twoją marką</span></h2>

      <p class="statement oem-lead" data-reveal="words">
        Każdy rozdzielacz z katalogu wykonamy z Twoim oznaczeniem i w Twoim opakowaniu. <span class="muted"
          >Także konfigurację spoza katalogu.</span
        >
      </p>

      <div class="oem-stack-wrap" data-reveal>
        <div class="brand-field" data-reveal style="--d: 180">
          <label class="brand-line">
            <span class="brand-label">Twoja marka</span>
            <input type="text" data-brand-input placeholder="wpisz nazwę" autocomplete="organization" spellcheck="false" />
          </label>
          <p class="note">Nazwa pojawi się na rozdzielaczu, na zdjęciu belki niżej i na pudełku u góry strony.</p>
        </div>
        <ManifoldExploded />
      </div>

      <div class="oem-proof">
        <figure class="bar" data-reveal>
          <div class="bar-crop">
            <div class="bar-zoom">
              <Image
                src={productImage('rw-pt')}
                alt="Zbliżenie belki rozdzielacza z naklejką oznaczenia"
                widths={[900, 1200, 1600]}
                sizes="(min-width: 960px) 1800px, 300vw"
                class="bar-img"
              />
              <span class="bar-sticker"><span data-brand data-brand-fit>TWOJA MARKA</span></span>
            </div>
          </div>
          <figcaption>Oznaczenie na belce. Tu będzie Twoja marka.</figcaption>
        </figure>

        <div class="oem-flow">
          <p class="label">Jak to działa</p>
          <ol class="steps" role="list">
            {
              steps.map((s, i) => (
                <li data-reveal style={`--d: ${i * 90}`}>
                  <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ol>
          <div class="oem-cta" data-reveal style="--d: 200">
            <a class="btn" href={`mailto:${company.email}`} data-brand-mailto={company.email}>
              Napisz zapytanie OEM
              <Icon name="arrow-up-right" size={18} />
            </a>
            <p>
              Otworzy się e-mail z gotowym szablonem. Adres: <a class="t-link" href={`mailto:${company.email}`}>{company.email}</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="sec about" id="o-firmie" aria-labelledby="about-h">
      <p class="kicker" data-reveal>O firmie</p>
      <div class="about-grid">
        <div class="about-text">
          <h2 class="statement" id="about-h" data-reveal="words">
            Rodzinna firma produkcyjna. <span class="muted">Od {company.foundingYear} roku w Nowej Wsi pod Włocławkiem.</span>
          </h2>
          <p data-reveal style="--d: 180">
            Specjalizujemy się w rozdzielaczach do ogrzewania podłogowego. Opieramy się na wieloletnim doświadczeniu w
            obróbce metali. Współpracujemy z hurtowniami w całym kraju, a nasze wyroby są doceniane także za granicą.
          </p>
        </div>
        <figure class="about-photo" data-reveal style="--d: 120">
          <Image
            src={factory}
            alt="Montaż belek rozdzielaczy w zakładzie Huber"
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 960px) 50vw, 100vw"
          />
        </figure>
      </div>
    </section>

    <section class="sec contact" id="kontakt" aria-labelledby="contact-h">
      <HeatLoops id="pw-loops" fade="left" />
      <div class="contact-in">
        <p class="kicker" data-reveal>Kontakt</p>
        <h2 class="statement" id="contact-h" data-reveal="words">
          Zapytaj o ofertę hurtową <span class="muted">albo o produkcję pod Twoją marką.</span>
        </h2>
        <a class="big-tel t-link" href={company.phoneHref}>
          <span class="rise" data-reveal="rise" style="--d: 120"><span>{company.phone}</span></span>
        </a>
        <a class="big-mail t-link" href={`mailto:${company.email}`} data-reveal style="--d: 240">{company.email}</a>
        <div class="contact-foot" data-reveal style="--d: 320">
          <address>
            {company.name}<br />
            {company.address.street}<br />
            {company.address.village}<br />
            {`${company.address.postalCode} ${company.address.city}`}
          </address>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <Logo height={18} ink="var(--ink)" paper="var(--bg)" />
    <p>© {year} {company.name}. {company.tagline} od {company.foundingYear} roku.</p>
    <a class="t-link" href="#top">Do góry</a>
  </footer>
</Base>

<script>
  import { initBrand } from '../../scripts/brand';
  import { initReveal } from '../../scripts/reveal';

  initBrand();
  initReveal();
</script>

<style is:global>
  :root {
    --bg: var(--color-warm-grey-50);
    --surface: #fff;
    --surface-2: color-mix(in oklab, var(--color-warm-grey-100) 50%, var(--color-warm-grey-50));
    --ink: var(--color-warm-grey-900);
    --ink-2: var(--color-warm-grey-700);
    --muted: var(--color-warm-grey-650);
    --line: var(--color-warm-grey-150);
    --line-2: var(--color-warm-grey-200);
    --kraft: var(--color-warm-grey-500);
    --kraft-ink: var(--color-warm-grey-700);
    --on-kraft: var(--color-warm-grey-50);
    --action: var(--color-warm-grey-700);
    --on-action: var(--color-warm-grey-50);
    --action-hover: var(--color-warm-grey-800);
    --action-edge: var(--color-warm-grey-900);
    --ink-accent: var(--color-warm-grey-750);
    --tone-accent: var(--color-warm-grey-650);
    --pad: clamp(16px, 2.5vw, 36px);
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    --display: 'Archivo Subset', 'Arial Narrow', Arial, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    /* BoxStage draws its focus ring with this colour. */
    --orange: var(--ink);
  }

  html {
    background: var(--bg);
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--display);
    font-size: 16px;
  }

  main [id] {
    scroll-margin-top: 96px;
  }

  .on-touch {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .on-fine {
      display: none;
    }

    .on-touch {
      display: inline;
    }
  }

  /* The padding and the matching negative margin keep ogonki and accents inside the clip. */
  .rise {
    display: block;
    overflow: hidden;
    padding: 0.06em 0 0.16em;
    margin: -0.06em 0 -0.16em;
  }

  html.reveal-on .rise[data-reveal] {
    opacity: 1;
    filter: none;
    transform: none;
  }

  html.reveal-on .rise[data-reveal] > span {
    display: block;
    transform: translateY(calc(100% + 0.3em));
    transition: transform 1100ms var(--ease) calc(var(--d, 0) * 1ms);
  }

  html.reveal-on .rise[data-reveal][data-shown] > span {
    transform: none;
  }

  html.reveal-on:not(.reveal-live) .rise[data-reveal] > span {
    animation: rise-failsafe 0s 2.5s forwards;
  }

  @keyframes rise-failsafe {
    to {
      transform: none;
    }
  }
</style>

<style>
  .kicker {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .kicker::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
    transform-origin: left;
    transition: transform 1200ms var(--ease) 150ms;
  }

  :global(.reveal-live) .kicker[data-reveal]:not([data-shown])::after {
    transform: scaleX(0);
  }

  .statement {
    max-width: 24ch;
    font-family: var(--display);
    font-stretch: 100%;
    font-size: clamp(26px, 2.8vw, 42px);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .muted {
    color: var(--tone-accent);
  }

  .sec-lead {
    max-width: 38ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .mega {
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 700;
    font-size: clamp(40px, 5vw, 76px);
    line-height: 0.82;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 6px;
    background: var(--action);
    color: var(--on-action);
    font-family: var(--display);
    font-stretch: 85%;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 160ms var(--ease),
      background-color 200ms ease;
  }

  /* Secondary: the same size and type as .btn, with an outline instead of a fill. */
  .btn--line {
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink);
  }

  /* Phones keep a 44px touch target. */
  @media (max-width: 639px) {
    .btn {
      min-height: 44px;
    }
  }

  .btn :global(svg) {
    transition: transform 200ms var(--ease);
  }

  .btn:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn:hover {
      background: var(--action-hover);
    }

    .btn--line:hover {
      border-color: var(--ink-accent);
    }

    .btn:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  .sec {
    margin-top: clamp(112px, 12vw, 176px);
    padding-inline: var(--pad);
  }

  .kicker {
    margin-bottom: clamp(28px, 3vw, 44px);
  }

  .hero {
    padding: 26px var(--pad) 0;
  }

  .hero-title {
    isolation: isolate;
    font-family: var(--display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(36px, 4.1vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.005em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .tape {
    position: relative;
    color: var(--on-kraft);
    display: inline-block;
    padding: 0 0.14em;
    white-space: nowrap;
  }

  /* Only the tape animates. The headline text stays visible, so it never delays the first paint. */
  .tape::before {
    content: '';
    position: absolute;
    inset: 0.02em 0 -0.04em;
    z-index: -1;
    background: var(--kraft);
    transform-origin: left;
    animation: tape-draw 800ms var(--ease) 350ms both;
  }

  @keyframes tape-draw {
    from {
      transform: scaleX(0);
    }
  }

  /* Taśma: brand packing tape, torn off at both ends and stuck on at a slight angle. */
  :global([data-tape='tasma']) .tape {
    padding-inline: 0.26em;
    rotate: -1.4deg;
  }

  :global([data-tape='tasma']) .tape::before {
    inset: -0.06em 0 -0.15em;
    clip-path: polygon(
      0.1em 0,
      calc(100% - 0.14em) 0,
      100% 10%,
      calc(100% - 0.1em) 22%,
      calc(100% - 0.02em) 35%,
      calc(100% - 0.13em) 48%,
      calc(100% - 0.03em) 61%,
      calc(100% - 0.15em) 74%,
      calc(100% - 0.05em) 87%,
      calc(100% - 0.12em) 100%,
      0.06em 100%,
      0.15em 89%,
      0.02em 77%,
      0.12em 64%,
      0 52%,
      0.1em 39%,
      0.01em 27%,
      0.14em 13%
    );
  }

  /* Marker: one brush stroke with ragged edges, from the #tape-rough filter beside the headline. */
  :global([data-tape='marker']) .tape {
    padding-inline: 0.24em;
  }

  :global([data-tape='marker']) .tape::before {
    inset: 0.03em 0 -0.03em;
    border-radius: 0.1em 0.24em 0.14em 0.28em;
    rotate: -0.8deg;
    filter: url(#tape-rough);
  }

  .tape-defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  .hero-stage {
    width: min(100%, calc((100svh - 330px) * 1.579));
    min-width: min(100%, 600px);
    margin: 4px auto 0;
  }

  /* The quiet line and the hint come in after the box. They are above the fold, so they do not wait for scroll. */
  .hero-hint,
  .hero-foot {
    animation: hero-in 900ms var(--ease) both;
  }

  .hero-hint {
    animation-delay: 600ms;
  }

  .hero-foot {
    animation-delay: 450ms;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-hint,
    .hero-foot,
    .tape::before {
      animation: none;
    }
  }

  .hero-hint {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--ink-2);
  }

  .hint-open {
    display: none;
  }

  .hero:has(:global([data-stage-wrap][data-open])) .hint-closed {
    display: none;
  }

  .hero:has(:global([data-stage-wrap][data-open])) .hint-open {
    display: inline;
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
    margin-top: 14px;
    padding: 16px 0 8px;
    border-top: 1px solid var(--line);
  }

  .hero-lead {
    max-width: 44ch;
    font-size: 17px;
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  /* A short lead sits under the heading, not in a far right column. */
  .sec-intro {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(56px, 7vw, 104px);
  }

  .custom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    margin-top: clamp(24px, 3vw, 40px);
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .custom p {
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.35;
  }

  .flag {
    padding: 2px 6px 1px;
    border-radius: 4px;
    background: var(--kraft);
    color: var(--on-kraft);
    font-family: var(--display);
    font-stretch: 80%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .oem-lead {
    max-width: 27ch;
    margin-top: clamp(32px, 4vw, 56px);
  }

  /* Centered over the model, in the same column as the legend under it. */
  .brand-field {
