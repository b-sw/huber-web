---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { company } from '../data/company';
import { withBase } from '../data/paths';
import '../styles/reset.css';

interface Props {
  title: string;
  description: string;
  // Link previews can use their own wording. Each one falls back to the page title and description.
  ogTitle?: string;
  ogDescription?: string;
  path?: string;
  themeColor?: string;
  noindex?: boolean;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  path = '/',
  themeColor = '#ffffff',
  noindex = false,
  ogImage,
  ogImageAlt,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(path, Astro.site);
const og = ogImage ? await getImage({ src: ogImage, width: 1200, format: 'jpg' }) : undefined;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  url: `${company.liveSite}/`,
  description: `${company.tagline}. Rodzinna firma produkcyjna od ${company.foundingYear} roku.`,
  foundingDate: String(company.foundingYear),
  email: company.email,
  telephone: company.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.village}, ${company.address.street}`,
    postalCode: company.address.postalCode,
    addressLocality: company.address.city,
    addressCountry: company.address.country,
  },
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: company.name,
  alternateName: `${company.name} Rozdzielacze`,
  url: `${company.liveSite}/`,
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    {
      og && (
        <>
          <meta property="og:image" content={new URL(og.src, Astro.site)} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(og.attributes.width)} />
          <meta property="og:image:height" content={String(og.attributes.height)} />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify([website, organization, ...jsonLd])} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
